# =====================================================================
# Health Benefits Shop — environment template
# Copy to .env.local for local dev. NEVER commit .env.local.
# Fill placeholder values from Neon, Google Cloud, Stripe, etc.
# =====================================================================

# ---- Neon Postgres ----
# Pooled connection (used at runtime). Get from Neon → Connect.
DATABASE_URL="postgresql://user:password@host-pooler.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Unpooled / direct connection (used by Drizzle migrations to avoid P1002 advisory-lock timeout).
# Toggle "Connection pooling" off in the Neon Connect dialog and copy that string.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ---- Auth.js (Google OAuth, site-gate) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-32-byte-random-string"

# Canonical site URL for OAuth callbacks. Use http://localhost:3009 for normal local dev.
# If you run `npm run dev:lan` (binds 0.0.0.0), set this to a browser-reachable URL, e.g.
# http://localhost:3009 or http://192.168.x.x:3009 — never leave Google/Auth redirects on 0.0.0.0.
AUTH_URL="http://localhost:3009"

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
AUTH_GOOGLE_ID="<google-oauth-client-id>"
AUTH_GOOGLE_SECRET="<google-oauth-client-secret>"

# Comma-separated list of email addresses allowed to sign in (app-level gate after Google).
# Fail-closed: if unset/empty, NO ONE can sign in.
# While Google OAuth publishing status is "Testing", each address must ALSO be under
# Google Cloud → Google Auth Platform → Audience → Test users, or Google blocks sign-in first.
ALLOWED_EMAILS="mike@example.com,peter@example.com"

# ---- Stripe ----
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---- Admin (token-based gate on top of Google sign-in for /admin) ----
ADMIN_TOKEN="long-random-string-for-admin-token"

# ---- Pi / scraper → POST /api/ingest/price-observations (Bearer). Falls back to ADMIN_TOKEN if unset. ----
PRICE_INGEST_SECRET="long-random-string-for-price-ingest-only"

# ---- Public base URL (Stripe success/cancel URLs, OAuth callbacks) ----
# Local dev with port 3009:
# NEXT_PUBLIC_BASE_URL="http://localhost:3009"
NEXT_PUBLIC_BASE_URL="https://healthbenefits.shop"

# ---- Daily pre-shipment job: GET /api/cron/pre-shipment with Authorization: Bearer <CRON_SECRET> ----
CRON_SECRET="random-string-for-cron-only"

# Days before scheduled_ship_at to send pre-shipment notice (default 7)
# PRE_SHIPMENT_NOTIFY_DAYS="7"

# ---- Optional: real email via Resend (https://resend.com). If unset, pre-shipment logs to console. ----
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="HealthBenefits <notifications@yourdomain.com>"

# ---- Benefit wallet (static demo / member-input pathway) ----
# Default off — existing self-entered budget wizard unchanged.
# BENEFIT_WALLET_ENABLED="true"
# BENEFIT_WALLET_MODE="static"
# BENEFIT_WALLET_MODE="member_input"
# BENEFIT_WALLET_STATIC_LABEL="OTC Benefit"
# BENEFIT_WALLET_STATIC_ALLOWANCE_CENTS="30000"
# BENEFIT_WALLET_STATIC_CADENCE="quarterly"
# BENEFIT_WALLET_STATIC_PRIOR_USED_CENTS="0"
# BENEFIT_WALLET_STATIC_PERIOD_LABEL="Jul–Sep 2026"
# BENEFIT_WALLET_STATIC_SHOW_DEMO_BADGE="true"
